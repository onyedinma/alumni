## ================================================
## PRODUCTION ENVIRONMENT - Namecheap Shared Hosting
## ================================================
## Copy this file to .env on the server and fill in the values.

# Application
APP_NAME="FGC Ohafia 2007 Alumni"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Logging (use 'single' on shared hosting for simpler log management)
LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (Get these from Namecheap cPanel > MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_cpanel_username_alumni
DB_USERNAME=your_cpanel_username_dbuser
DB_PASSWORD=your_secure_db_password

# Drivers
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail (Gmail SMTP - requires App Password)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Storage
STORAGE_DRIVER=public
