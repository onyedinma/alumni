# Application Settings
APP_NAME=Alumni
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL="https://your-domain.com"

# Logging - use "error" or "warning" in production
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database
DB_CONNECTION=mysql
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="alumni"
DB_USERNAME="root"
DB_PASSWORD=""

# Caching & Sessions - use "redis" or "file" for production
BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER="smtp"
MAIL_HOST="your-smtp-host"
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage
STORAGE_DRIVER="public"
